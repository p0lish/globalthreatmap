# Application Mode
# Set to "valyu" for OAuth-based mode, or leave empty for self-hosted mode
APP_MODE=

# Valyu API (required for self-hosted mode)
VALYU_API_KEY=

# Valyu OAuth (required for valyu mode)
VALYU_CLIENT_ID=
VALYU_CLIENT_SECRET=
VALYU_AUTH_URL=https://platform.valyu.ai
VALYU_APP_URL=https://platform.valyu.ai
VALYU_OAUTH_PROXY_URL=

# OAuth Redirect
REDIRECT_URI=http://localhost:5173/auth/callback

# OpenAI (optional - for AI-enhanced classification)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-nano

# Mapbox (required for geocoding)
MAPBOX_TOKEN=

# Public environment variables (accessible in browser)
# These are prefixed with VITE_ for SvelteKit/Vite
VITE_MAPBOX_TOKEN=
VITE_APP_MODE=
VITE_VALYU_CLIENT_ID=
VITE_VALYU_AUTH_URL=https://platform.valyu.ai
VITE_REDIRECT_URI=http://localhost:5173/auth/callback
